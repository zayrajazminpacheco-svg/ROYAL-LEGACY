generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String         @id @default(cuid())
  name                       String
  email                      String         @unique
  phone                      String?
  passwordHash               String
  role                       Role           @default(CLIENT)
  status                     UserStatus     @default(PENDING)
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  auditLogs                  AuditLog[]
  clientProfile              ClientProfile?
  sales                      Sale[]         @relation("ClientSales")
  Sale_Sale_employeeIdToUser Sale[]         @relation("Sale_employeeIdToUser")
}

model ClientProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Provider {
  id                String          @id @default(cuid())
  name              String
  websiteUrl        String?
  balance           Decimal         @default(0)
  status            ProviderStatus  @default(ACTIVE)
  automationEnabled Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  inventory         InventoryItem[]
  ProviderOffer     ProviderOffer[]
  panels            ProviderPanel[]
  SaleItem          SaleItem[]
}

model ProviderPanel {
  id             String          @id @default(cuid())
  providerId     String
  name           String
  panelUrl       String
  panelType      String?
  instructions   String?
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  inventoryItems InventoryItem[]
  provider       Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model Product {
  id          String           @id @default(cuid())
  categoryId  String
  name        String
  slug        String           @unique
  description String?
  imageUrl    String?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  Category    Category         @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
}

model ProductVariant {
  id            String          @id @default(cuid())
  productId     String
  accessType    AccessType
  durationDays  Int
  publicName    String
  publicPrice   Decimal
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  InventoryItem InventoryItem[]
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  ProviderOffer ProviderOffer[]
  SaleItem      SaleItem[]
}

model InventoryItem {
  id                        String           @id @default(cuid())
  productVariantId          String
  providerId                String?
  providerPanelId           String?
  saleItemId                String?          @unique
  loginEmailEncrypted       String?
  loginEmailMasked          String?
  loginEmailHash            String?
  passwordEncrypted         String?
  passwordMode              PasswordMode     @default(STATIC)
  profileNameEncrypted      String?
  profilePinEncrypted       String?
  externalLookupIdEncrypted String?
  externalReference         String?
  notes                     String?
  internalCost              Decimal          @default(0)
  salePrice                 Decimal?
  status                    InventoryStatus  @default(AVAILABLE)
  acquiredAt                DateTime         @default(now())
  expirationDate            DateTime?
  soldAt                    DateTime?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  CodeRequest               CodeRequest[]
  InventoryAlias            InventoryAlias[]
  ProductVariant            ProductVariant   @relation(fields: [productVariantId], references: [id])
  provider                  Provider?        @relation(fields: [providerId], references: [id])
  providerPanel             ProviderPanel?   @relation(fields: [providerPanelId], references: [id])
  SaleItem                  SaleItem?        @relation(fields: [saleItemId], references: [id])
}

model Sale {
  id                         String      @id @default(cuid())
  clientId                   String
  employeeId                 String?
  status                     SaleStatus  @default(PENDING)
  subtotal                   Decimal
  total                      Decimal
  internalCost               Decimal     @default(0)
  profit                     Decimal     @default(0)
  paymentReference           String?
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt
  client                     User        @relation("ClientSales", fields: [clientId], references: [id])
  User_Sale_employeeIdToUser User?       @relation("Sale_employeeIdToUser", fields: [employeeId], references: [id])
  items                      SaleItem[]
}

model SaleItem {
  id               String         @id @default(cuid())
  saleId           String
  productVariantId String
  providerId       String?
  quantity         Int
  unitPrice        Decimal
  internalCost     Decimal
  expirationDate   DateTime?
  warrantyEndDate  DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime
  InventoryItem    InventoryItem?
  ProductVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  Provider         Provider?      @relation(fields: [providerId], references: [id])
  sale             Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model InboxMessage {
  id                        String      @id @default(cuid())
  emailAliasId              String?
  externalMessageId         String?     @unique
  sender                    String?
  recipient                 String
  subject                   String?
  bodyPreview               String?
  bodyEncrypted             String?
  verificationCodeEncrypted String?
  processed                 Boolean     @default(false)
  receivedAt                DateTime    @default(now())
  createdAt                 DateTime    @default(now())
  EmailAlias                EmailAlias? @relation(fields: [emailAliasId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Product     Product[]
}

model CodeRequest {
  id              String            @id
  inventoryItemId String
  requestedById   String?
  codeEncrypted   String?
  status          CodeRequestStatus @default(PENDING)
  requestedAt     DateTime          @default(now())
  receivedAt      DateTime?
  deliveredAt     DateTime?
  expiresAt       DateTime?
  notes           String?
  InventoryItem   InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
}

model EmailAlias {
  id                        String           @id
  domainId                  String
  localPart                 String
  fullAddress               String           @unique
  destinationEmailEncrypted String?
  destinationEmailMasked    String?
  platformGroup             String?
  status                    AliasStatus      @default(AVAILABLE)
  assignedAt                DateTime?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime
  MailDomain                MailDomain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  InboxMessage              InboxMessage[]
  InventoryAlias            InventoryAlias[]

  @@unique([domainId, localPart])
}

model InventoryAlias {
  id              String        @id
  inventoryItemId String
  emailAliasId    String
  active          Boolean       @default(true)
  assignedAt      DateTime      @default(now())
  releasedAt      DateTime?
  EmailAlias      EmailAlias    @relation(fields: [emailAliasId], references: [id], onDelete: Cascade)
  InventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([inventoryItemId, emailAliasId])
}

model MailDomain {
  id               String       @id
  domain           String       @unique
  providerName     String?
  platformGroup    String?
  catchAllEnabled  Boolean      @default(false)
  rotationGroup    String?
  rotationPriority Int          @default(0)
  status           DomainStatus @default(ACTIVE)
  verifiedAt       DateTime?
  expiresAt        DateTime?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime
  EmailAlias       EmailAlias[]
}

model ProviderOffer {
  id                 String             @id
  providerId         String
  productVariantId   String
  internalCost       Decimal
  priority           Int                @default(0)
  availabilityStatus AvailabilityStatus @default(UNKNOWN)
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime
  ProductVariant     ProductVariant     @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  Provider           Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
  CLIENT
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  UNKNOWN
}

enum SaleStatus {
  PENDING
  PAID
  PROCESSING
  DELIVERED
  EXPIRED
  REFUNDED
}

enum AccessType {
  PROFILE
  FULL_ACCOUNT
  INVITATION
  NEW_EMAIL
  FAMILY
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  SOLD
  BLOCKED
  EXPIRED
  MAINTENANCE
}

enum AliasStatus {
  AVAILABLE
  ASSIGNED
  PAUSED
  BLOCKED
}

enum CodeRequestStatus {
  PENDING
  RECEIVED
  DELIVERED
  EXPIRED
  FAILED
}

enum DomainStatus {
  ACTIVE
  PAUSED
  REJECTED_BY_PLATFORM
  EXPIRED
}

enum PasswordMode {
  STATIC
  RESET_IN_PANEL
  INVITATION
  NONE
}