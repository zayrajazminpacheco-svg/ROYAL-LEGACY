PORT=3000
NODE_ENV=development
JWT_SECRET=legacy-royal-stream-dev-secret
JWT_EXPIRES_IN=8h
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legacy_royal_stream?schema=public

# Firebase configuration placeholders
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Super admin bootstrap credentials
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Datos para recibir recargas SPEI
# Configura los mismos valores también en Render > Environment.
SPEI_RECEIVER_NAME=
SPEI_RECEIVER_BANK=
SPEI_RECEIVER_ACCOUNT=
SPEI_MIN_AMOUNT=10
SPEI_MAX_AMOUNT=50000
